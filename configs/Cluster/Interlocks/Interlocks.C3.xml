<?xml version="1.0" encoding="utf-8"?>
<interlocks>
	<!-- ============================================================ -->
	<!-- C3 vacuum topology:                                          -->
	<!--   chamber =[C3_GV]= TP =[C3_FL]= SP(backing)                 -->
	<!--   chamber =[C3_RL]= SP   (roughing line, bypasses the TP)    -->
	<!--   chamber =[C3_A1]= atmosphere (vent)                        -->
	<!--   chamber =[SV_C3]= transfer module                          -->
	<!-- SP's inlet manifold (C3_FL + C3_RL) must never be open       -->
	<!-- simultaneously; the TP must never be stranded without        -->
	<!-- foreline backing while pumping the chamber.                  -->
	<!-- ============================================================ -->

	<!-- Foreline open requires the backing pump running AND the
	     roughing line closed (manifold exclusivity). -->
	<interlock id="Valve_C3_FL_open">
		<l>Pump C3_SP on</l>
		<l>Valve C3_RL closed</l>
	</interlock>

	<!-- Foreline close requires the gate closed: closing the foreline
	     while the gate is open strands the spinning turbo with no
	     backing path. (Gate-closed, not TP-off, so the warm pump-out
	     can still close FL with the TP coasting during roughing.) -->
	<interlock id="Valve_C3_FL_close">
		<l>Valve C3_GV closed</l>
	</interlock>

	<!-- Backing pump off requires both of its manifold valves closed. -->
	<interlock id="Pump_C3_SP_off">
		<l>Valve C3_FL closed</l>
		<l>Valve C3_RL closed</l>
	</interlock>

	<!-- Roughing line open requires the gate closed (so the rough-side
	     pressure never reaches the turbo), the foreline closed (manifold
	     exclusivity), and the backing pump running. -->
	<interlock id="Valve_C3_RL_open">
		<l>Valve C3_GV closed</l>
		<l>Valve C3_FL closed</l>
		<l>Pump C3_SP on</l>
	</interlock>

	<!-- Gate open requires the chamber roughed below 50 mTorr (never
	     expose the turbo to atmosphere) and the roughing line closed. -->
	<interlock id="Valve_C3_GV_open">
		<l>Sensor C3_pm less 5.0e-2</l>
		<l>Valve C3_RL closed</l>
	</interlock>

	<!-- Vent requires the slit closed (else venting floods the whole
	     transfer module and every other open chamber), the gate closed
	     (don't vent into the turbo) and the roughing line closed (don't
	     vent into the backing pump). FL may stay open: with the gate
	     closed the foreline cannot see the vented chamber. -->
	<interlock id="Valve_C3_A1_open">
		<l>Valve SV_C3 closed</l>
		<l>Valve C3_GV closed</l>
		<l>Valve C3_RL closed</l>
	</interlock>

	<!-- Gas inlet must only open when C3 is pumped (gate open). -->
	<interlock id="Valve_C3_V_open">
		<l>Valve C3_GV open</l>
	</interlock>

	<!-- Source power on requires working gas + gate open. -->
	<interlock id="Power_C3_PSU1_on">
		<l>Valve C3_V open</l>
		<l>Valve C3_GV open</l>
	</interlock>

	<!-- N2 inlet must only open when C3 is pumped (gate open). -->
	<interlock id="Valve_C3_V_N2_open">
		<l>Valve C3_GV open</l>
	</interlock>

	<!-- Second supply: same guard — Ar working gas + gate open.
	     (Ar always flows during reactive operation; the interlock engine has
	     no OR predicate, so N2-only operation is intentionally not a valid
	     power-on precondition.) -->
	<interlock id="Power_C3_PSU2_on">
		<l>Valve C3_V open</l>
		<l>Valve C3_GV open</l>
	</interlock>
</interlocks>
