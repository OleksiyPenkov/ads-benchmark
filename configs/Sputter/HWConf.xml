<?xml version="1.0" encoding="utf-8"?>
<!--
  Sputter - Single-chamber two-magnetron demo system.
  Open reference stack: S7-200 PLC (APS.Hardware.S7) and LAN power supplies (APS.Hardware.Demo).
-->
<hardware xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <libraries>
    <library lib="S7">APS.Hardware.S7.dll</library>
    <library lib="Demo">APS.Hardware.Demo.dll</library>
  </libraries>
  <plcs lib="S7">
    <plc type="APS.Hardware.S7.S7200PLC" address="127.0.0.1">main</plc>
  </plcs>
  <valves lib="S7" hwtype="APS.Hardware.S7.S7200GasValve" host="main">
    <valve address="12" index="1" descr="Ar inlet">V1</valve>
    <valve address="12" index="2" descr="N2 inlet">V2</valve>
    <valve address="2" index="3" descr="Magnetron 1">M1</valve>
    <valve address="12" index="7" descr="Magnetron 2">M2</valve>
  </valves>
  <valves lib="S7" hwtype="APS.Hardware.S7.S7200Valve" host="main">
    <valve address="2" index="4" descr="Pre-pump">PP</valve>
    <valve address="2" index="6" descr="Fore line">FL</valve>
    <valve address="2" index="1" vent="true" chamber="Main" conductance="3.0" descr="Air vent">A1</valve>
    <valve address="3" index="3" chamber="Main" descr="Magnetron 1 shutter">Sh1</valve>
    <valve address="3" index="4" chamber="Main" descr="Magnetron 2 shutter">Sh2</valve>
  </valves>
  <valves lib="S7" hwtype="APS.Hardware.S7.S7200InputValve" host="main">
    <valve address="2" index="6" descr="Gate Main">GVM</valve>
  </valves>
  <mfcs lib="S7" hwtype="APS.Hardware.S7.S7200MFC" host="main">
    <mfc address="160" descr="MFC Ar" chamber="Main">Ar1</mfc>
    <mfc address="168" descr="MFC N2" chamber="Main">N21</mfc>
  </mfcs>
  <sensors lib="S7" hwtype="APS.Hardware.S7.S7200Sensor" host="main">
    <sensor address="100" chamber="Main" descr="System">pm</sensor>
    <sensor address="124" chamber="Main" property="Temperature" descr="Temp">tmp</sensor>
  </sensors>
  <pumps lib="S7" hwtype="APS.Hardware.S7.S7200TurboPump" host="main">
    <pump address="17" writeaddr="0" writeindex="4" chamber="Main" gate="GVM" foreline="FL" descr="Main pump">TP</pump>
  </pumps>
  <pumps lib="S7" hwtype="APS.Hardware.S7.S7200Pump" host="main">
    <pump address="0" index="5" chamber="Main" gate="PP" descr="Backing pump">SP1</pump>
  </pumps>
  <stages lib="S7" hwtype="APS.Hardware.S7.S7200RotationStage" host="main">
    <stage address="1974" feedbackAddr="1978" enableByte="30" enableBit="0" descr="Substrate Rotation" operational="false">rotation</stage>
  </stages>
  <stages lib="S7" hwtype="APS.Hardware.S7.S7200Stage" host="main">
    <stage address="152" MB="7" index="1" presets="Load:0;Process:25" homePos="0" descr="Substrate lift">VS</stage>
  </stages>
  <powersupplies lib="Demo" hwtype="APS.Hardware.Demo.LanPowerSupply">
    <powersupply host="127.0.0.1" port="5025" mode="PDC" descr="Pulsed DC (M1)">PSU1</powersupply>
    <powersupply host="127.0.0.1" port="5026" mode="RF" descr="RF (M2)">PSU2</powersupply>
  </powersupplies>
</hardware>